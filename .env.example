# ── Google OAuth client (Google Auth Platform → Clients → Desktop app) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Your body and routine (used by the weekly report) ──
# Starting values only: after that, log weight in the app (or Google Health) and set height there.
WEIGHT_KG=
HEIGHT_CM=
# Timezone for the scheduler, e.g. Europe/London, America/New_York, Asia/Kolkata
TZ=UTC
# Hour ranges on the 24h clock. Overnight ranges are fine, e.g. 23-00 or 18-03.
TARGET_BEDTIME=23-00
TARGET_WAKE=07-08
# Optional: your working hours, e.g. 09-17, or 18-03 for a night shift
WORK_HOURS=
# Days you don't work (day-off nights are shown separately in the report)
DAYS_OFF=Sat,Sun
# Optional: only use data from this device (as shown in the report header). Default: any Fitbit/Pixel wearable
DEVICE_NAME=

# ── Schedule ──
# Daily catch-up hour (local). Pick ~2h after you usually wake so last night's sleep is processed.
CATCHUP_HOUR=10
# Optional: also poll every N hours (useful if you don't set up webhooks)
POLL_EVERY_HOURS=

# ── Webhooks (optional, needs a public HTTPS URL, e.g. a Cloudflare tunnel) ──
GOOGLE_PROJECT_NUMBER=
WEBHOOK_URL=https://health.example.com/webhook
# Generate with: openssl rand -hex 32. Leave empty to run in polling-only mode.
WEBHOOK_SECRET=

# ── Report web page (optional) ──
# Serves the last-7-days PDF at https://<your tunnel>/ behind a browser login.
# No login by default: protect the hostname upstream (e.g. Cloudflare Access).
# Set REPORT_BASIC_AUTH=true to require REPORT_USER/REPORT_PASSWORD (openssl rand -base64 24).
REPORT_BASIC_AUTH=false
REPORT_USER=me
REPORT_PASSWORD=

# ── Assistant (the chat on the home page) ──
# Powered by LiteLLM, so any provider works: set ASSISTANT_MODEL to "<provider>/<model>" and that provider's key.
# Your messages and the health data it looks up are sent to that provider.
# Default: Ollama Cloud. Key from https://ollama.com/settings/keys. If the model tag differs, check `ollama.com/search?c=cloud`.
ASSISTANT_MODEL=ollama_chat/glm-5.3-flash
OLLAMA_API_BASE=https://ollama.com
OLLAMA_API_KEY=
# Other examples: openai/gpt-5-mini (OPENAI_API_KEY), gemini/gemini-2.5-flash (GEMINI_API_KEY),
# ollama_chat/llama3.1 with OLLAMA_API_BASE=http://host.docker.internal:11434 for a local Ollama.
# Reasoning models think before answering: low keeps replies fast (low|medium|high).
ASSISTANT_REASONING=low
# Model that rewrites data/MEMORY.md after each conversation (default: same as ASSISTANT_MODEL).
MEMORY_MODEL=

# ── Alerts (optional) ──
# Push alerts to https://ntfy.sh/<topic>
NTFY_TOPIC=
# Dead-man's switch pinged after each daily sync, e.g. https://hc-ping.com/<uuid>
HEARTBEAT_URL=
