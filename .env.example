# ── Google OAuth client (Google Auth Platform → Clients → Desktop app) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Your body and routine (used by the weekly report) ──
WEIGHT_KG=
HEIGHT_CM=
# Timezone for the scheduler, e.g. Europe/London, America/New_York, Asia/Kolkata
TZ=UTC
# Hour ranges on the 24h clock. Overnight ranges are fine, e.g. 23-00 or 18-03.
TARGET_BEDTIME=23-00
TARGET_WAKE=07-08
# Optional: your working hours, e.g. 09-17, or 18-03 for a night shift
WORK_HOURS=
# Days you don't work (day-off nights are shown separately in the report)
DAYS_OFF=Sat,Sun
# Optional: only use data from this device (as shown in the report header). Default: any Fitbit/Pixel wearable
DEVICE_NAME=

# ── Schedule ──
# Daily catch-up hour (local). Pick ~2h after you usually wake so last night's sleep is processed.
CATCHUP_HOUR=10
# Optional: also poll every N hours (useful if you don't set up webhooks)
POLL_EVERY_HOURS=

# ── Webhooks (optional, needs a public HTTPS URL, e.g. a Cloudflare tunnel) ──
GOOGLE_PROJECT_NUMBER=
WEBHOOK_URL=https://health.example.com/webhook
# Generate with: openssl rand -hex 32. Leave empty to run in polling-only mode.
WEBHOOK_SECRET=

# ── Alerts (optional) ──
# Push alerts to https://ntfy.sh/<topic>
NTFY_TOPIC=
# Dead-man's switch pinged after each daily sync, e.g. https://hc-ping.com/<uuid>
HEARTBEAT_URL=
